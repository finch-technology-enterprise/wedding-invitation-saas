{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wedding-invite-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "account_id": "959964199031cc8596d57f3f940800a8",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Photo slots go through the Worker so an unsupplied photograph can
    // answer 204 instead of 404 (see src/index.ts).
    "run_worker_first": ["/api/*", "/assets/photos/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "invite",
      "database_id": "0a96e4f3-3d0b-479e-b241-56b8dfad365a",
      "migrations_dir": "migrations"
    }
  ]
}
