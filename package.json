{
  "name": "wedding-invite",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "check": "tsc",
    "deploy": "wrangler deploy",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "build:admin": "vite build",
    "dev:admin": "vite",
    "check:admin": "tsc -p admin/tsconfig.json",
    "build": "npm run build:admin && npm run build:platform",
    "test:admin": "playwright test -c playwright.admin.config.ts",
    "build:platform": "BUILD_TARGET=platform vite build"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260822.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "allowScripts": {
    "workerd@1.20260820.1": true,
    "esbuild@0.28.1": true
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/core": "^9.6.0",
    "@mantine/dates": "^9.6.0",
    "@mantine/dropzone": "^9.6.0",
    "@mantine/form": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@mantine/modals": "^9.6.0",
    "@mantine/notifications": "^9.6.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.102.8",
    "dayjs": "^1.11.23",
    "hono": "^4.13.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4"
  }
}
