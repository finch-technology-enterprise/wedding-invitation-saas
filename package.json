{
  "name": "invitation-platform",
  "version": "0.1.0",
  "description": "A cinematic wedding-invitation platform on Cloudflare Workers, D1 and R2. Self-hostable, multi-tenant, with a frozen dependency-free public renderer.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "keywords": [
    "cloudflare-workers",
    "wedding-invitation",
    "d1",
    "r2",
    "saas",
    "self-hosted",
    "hono"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/my-johnlee/invitation-platform.git"
  },
  "homepage": "https://github.com/my-johnlee/invitation-platform#readme",
  "bugs": {
    "url": "https://github.com/my-johnlee/invitation-platform/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:admin": "vite",
    "build": "npm run build:admin && npm run build:platform",
    "build:admin": "vite build",
    "build:platform": "BUILD_TARGET=platform vite build",
    "typecheck": "tsc --noEmit && tsc -p admin/tsconfig.json",
    "check": "npm run typecheck",
    "check:admin": "tsc -p admin/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:admin": "playwright test -c playwright.admin.config.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260822.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "@types/phc__format": "^1.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/core": "^9.6.0",
    "@mantine/dates": "^9.6.0",
    "@mantine/dropzone": "^9.6.0",
    "@mantine/form": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@mantine/modals": "^9.6.0",
    "@mantine/notifications": "^9.6.0",
    "@phc/format": "^1.0.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.102.8",
    "dayjs": "^1.11.23",
    "hono": "^4.13.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "allowScripts": {
    "workerd@1.20260820.1": true,
    "esbuild@0.28.1": true
  }
}
